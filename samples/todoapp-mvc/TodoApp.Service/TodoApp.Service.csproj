<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Datasync.Server" Version="10.1.2" />
    <PackageReference Include="CommunityToolkit.Datasync.Server.EntityFrameworkCore" Version="10.1.2" />
    <!-- Pin Microsoft.Data.SqlClient to resolve NU1902/NU1903 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7): Microsoft.EntityFrameworkCore.SqlServer floats SqlClient 6.1.7 -> System.Security.Cryptography.Pkcs 9.0.11. Remove once EF Core SqlServer floats a patched SqlClient. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="Microsoft.Web.LibraryManager.Build" Version="3.0.114" />
  </ItemGroup>

  <Target Name="CleanWwwRootLib" AfterTargets="Clean">
    <RemoveDir Directories="$(ProjectDir)wwwroot\lib" />
  </Target>
</Project>
